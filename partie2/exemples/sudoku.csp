// Sudoku 9x9. Givens: puzzle from Wikipedia ("Sudoku" article).

const N = 9;

array grid[N][N] : 1..N;

forall i in 1..N {
    constraint allDifferent(grid[i][*]);    // rows
    constraint allDifferent(grid[*][i]);    // columns
}

// boxes: no slice selects a box, list the 9 cells
forall bi in 0..2, bj in 0..2 {
    constraint allDifferent(
        grid[3*bi + 1][3*bj + 1], grid[3*bi + 1][3*bj + 2], grid[3*bi + 1][3*bj + 3],
        grid[3*bi + 2][3*bj + 1], grid[3*bi + 2][3*bj + 2], grid[3*bi + 2][3*bj + 3],
        grid[3*bi + 3][3*bj + 1], grid[3*bi + 3][3*bj + 2], grid[3*bi + 3][3*bj + 3]);
}

// givens: 0 = empty cell
const given[N][N] = [
    [5, 3, 0,  0, 7, 0,  0, 0, 0],
    [6, 0, 0,  1, 9, 5,  0, 0, 0],
    [0, 9, 8,  0, 0, 0,  0, 6, 0],

    [8, 0, 0,  0, 6, 0,  0, 0, 3],
    [4, 0, 0,  8, 0, 3,  0, 0, 1],
    [7, 0, 0,  0, 2, 0,  0, 0, 6],

    [0, 6, 0,  0, 0, 0,  2, 8, 0],
    [0, 0, 0,  4, 1, 9,  0, 0, 5],
    [0, 0, 0,  0, 8, 0,  0, 7, 9]
];

forall i in 1..N, j in 1..N {
    constraint given[i][j] != 0 -> grid[i][j] = given[i][j];
}
